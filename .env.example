# Получить на https://my.telegram.org/apps
API_ID=
API_HASH=

# Получить у @BotFather
BOT_TOKEN=

# Telegram ID пользователей, которым разрешено управлять ботом (через запятую).
# Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# Путь (без расширения) к файлу сессии Telethon
SESSION_NAME=data/userbot

# Путь к JSON-файлу с чатами/ключевыми словами/стоп-словами
CONFIG_PATH=data/config.json
